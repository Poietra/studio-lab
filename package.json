{
  "name": "@poietra/studio-lab",
  "version": "0.0.0",
  "private": true,
  "main": "dist-electron/app-main.mjs",
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run src/accounts src/ai src/billing src/collaboration src/engine src/studio e2e/benchmark-support.test.ts e2e/fourier-v3-cairo-reference.test.ts e2e/spiral-in-cairo-reference.test.ts e2e/square-to-circle-cairo-reference.test.ts e2e/write-stuff-cairo-reference.test.ts e2e/visual-parity.test.ts --exclude src/studio/workspace-projection.test.ts",
    "test:integration": "vitest run server src/render-pipeline src/studio/workspace-projection.test.ts scripts/derive-mathtex-artifact.test.ts scripts/real-manim-census-producer-identity.test.ts scripts/real-manim-editability-census-report.test.ts scripts/rollout-billing-entitlement.test.ts",
    "test:billing:stripe:required": "POIETRA_STRIPE_E2E_REQUIRED=1 vitest run server/billing/stripe-sandbox.real.test.ts",
    "test:storage:e2e": "node scripts/run-workspace-source-storage-e2e.mjs",
    "test:storage:r2:required": "POIETRA_R2_CONFORMANCE_REQUIRED=1 vitest run server/storage/s3/r2-private-immutable-storage.real.test.ts",
    "test:engine:wasm-smoke": "node scripts/smoke-engine-wasm.mjs",
    "test:mathtex:wasm-smoke": "node scripts/smoke-mathtex-wasm.mjs",
    "test:mathtex:python-smoke": "node scripts/smoke-mathtex-python.mjs",
    "test:third-party-notices": "node scripts/smoke-third-party-notices.mjs",
    "test:mathtex:wasm-size": "node scripts/measure-mathtex-wasm.mjs --check",
    "test:manim-smoke": "node scripts/run-manim-smoke.mjs",
    "census:manim": "node scripts/run-real-manim-census.mjs",
    "census:manim:v2": "POIETRA_REAL_MANIM_PROJECT_CENSUS_REQUIRED=1 vitest run scripts/run-real-manim-project-census.real.test.ts",
    "census:fast-manim:mathtex": "python3 scripts/verify-fast-manim-mathtex-callsite-corpus.py --repository ../fast-manim",
    "test:render-sandbox:oci:required": "POIETRA_MANIM_RENDER_GATED_OCI_REQUIRED=1 vitest run server/manim-render-gated-oci.real.test.ts",
    "test:render-sandbox:production:required": "POIETRA_MANIM_RENDER_PRODUCTION_REQUIRED=1 vitest run server/manim-render-production-sandbox-broker-service.real.test.ts",
    "test:snapshot-sandbox:production:required": "POIETRA_FAST_MANIM_PRODUCTION_REQUIRED=1 vitest run server/fast-manim-production-sandbox-broker-service.real.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:account": "node e2e/account-production-runner.mjs",
    "test:e2e:preview": "pnpm test:e2e:preview:chromium && pnpm test:e2e:preview:webgpu",
    "test:e2e:preview:chromium": "playwright test --config playwright.preview.config.ts --project preview-chromium --fully-parallel --workers 4",
    "test:e2e:preview:webgpu": "playwright test --config playwright.preview.config.ts --project preview-webgpu --workers 1",
    "test:e2e:preview:real": "playwright test --config playwright.real-preview.config.ts",
    "test:e2e:preview:real:runtime-trace": "PATH=\"${POIETRA_CAIRO_TEX_BIN:-$HOME/.TinyTeX/bin/x86_64-linux}:$PATH\" POIETRA_E2E_REAL_PREVIEW_PROFILE=runtime-trace playwright test --config playwright.real-preview.config.ts",
    "test:e2e:preview:real:runtime-trace:cairo-parity": "PATH=\"${POIETRA_CAIRO_TEX_BIN:-$HOME/.TinyTeX/bin/x86_64-linux}:$PATH\" POIETRA_E2E_REAL_PREVIEW_PROFILE=runtime-trace POIETRA_RUNTIME_TRACE_CAIRO_PARITY_REQUIRED=1 playwright test --config playwright.real-preview.config.ts",
    "test:e2e:preview:real:runtime-trace:opening:cairo-parity": "PATH=\"${POIETRA_CAIRO_TEX_BIN:-$HOME/.TinyTeX/bin/x86_64-linux}:$PATH\" POIETRA_E2E_REAL_PREVIEW_PROFILE=runtime-trace-opening POIETRA_RUNTIME_TRACE_CAIRO_PARITY_REQUIRED=1 playwright test --config playwright.real-preview.config.ts",
    "test:e2e:preview:real:mathtex": "POIETRA_E2E_REAL_PREVIEW_PROFILE=3 playwright test --config playwright.real-preview.config.ts",
    "test:e2e:preview:real:mathtex-morph": "POIETRA_E2E_REAL_PREVIEW_PROFILE=5 playwright test --config playwright.real-preview.config.ts",
    "test:e2e:preview:real:image": "POIETRA_E2E_REAL_PREVIEW_PROFILE=4 playwright test --config playwright.real-preview.config.ts",
    "test:e2e:preview:real:mixed": "POIETRA_E2E_REAL_PREVIEW_PROFILE=7 playwright test --config playwright.real-preview.config.ts",
    "test:e2e:preview:real:square-to-circle": "POIETRA_E2E_REAL_PREVIEW_PROFILE=8 playwright test --config playwright.real-preview.config.ts",
    "test:e2e:preview:real:square-to-circle:cairo-parity": "POIETRA_E2E_REAL_PREVIEW_PROFILE=8 POIETRA_SQUARE_TO_CIRCLE_CAIRO_PARITY_REQUIRED=1 playwright test --config playwright.real-preview.config.ts",
    "test:e2e:preview:real:warp-square": "POIETRA_E2E_REAL_PREVIEW_PROFILE=9 playwright test --config playwright.real-preview.config.ts",
    "test:e2e:preview:real:line-joints": "POIETRA_E2E_REAL_PREVIEW_PROFILE=10 playwright test --config playwright.real-preview.config.ts",
    "test:e2e:preview:real:spiral-in": "POIETRA_E2E_REAL_PREVIEW_PROFILE=11 playwright test --config playwright.real-preview.config.ts",
    "test:e2e:preview:real:write-stuff": "POIETRA_E2E_REAL_PREVIEW_PROFILE=12 playwright test --config playwright.real-preview.config.ts",
    "test:e2e:visual-parity": "playwright test --config playwright.visual-parity.config.ts",
    "test:electron-packaged": "pnpm package:electron && node scripts/electron-packaged-smoke.mjs",
    "test:e2e:webkit-smoke": "playwright test --project=webkit-minimum",
    "lint": "biome lint --error-on-warnings .",
    "lint:fix": "biome lint --write .",
    "format": "node scripts/biome-changed.mjs --write",
    "format:check": "node scripts/biome-changed.mjs",
    "check:style": "pnpm lint && pnpm format:check",
    "dev:web": "vite --host 127.0.0.1",
    "electron:install": "install-electron",
    "dev:electron": "pnpm electron:install && pnpm build:electron:main && concurrently --kill-others --success first \"pnpm dev:web\" \"wait-on tcp:127.0.0.1:5173 && electron dist-electron/app-main.mjs\"",
    "dev:tauri": "tauri dev",
    "evaluate:shell:native": "node scripts/shell-evaluation.mjs native",
    "evaluate:shell:serve": "node scripts/shell-evaluation.mjs prepare && vite --host 127.0.0.1 --port 4174 --strictPort",
    "benchmark:engine:webgpu": "node scripts/run-engine-webgpu-benchmark.mjs",
    "benchmark:engine:webgpu:promote": "node scripts/promote-engine-webgpu-benchmark-evidence.mjs",
    "benchmark:engine:webgpu:verify": "node scripts/promote-engine-webgpu-benchmark-evidence.mjs --verify",
    "billing:entitlement:rollout": "node scripts/rollout-billing-entitlement.mjs",
    "evidence:manim-compositor:promote": "node scripts/promote-manim-compositor-parity-evidence.mjs",
    "evidence:manim-compositor:verify": "node scripts/promote-manim-compositor-parity-evidence.mjs --verify",
    "visual-parity:regenerate": "node scripts/regenerate-visual-parity.mjs",
    "sandbox:oci:gated:build": "node scripts/build-fast-manim-gated-oci.mjs",
    "sandbox:oci:render:build": "node scripts/build-fast-manim-gated-oci.mjs render",
    "sandbox:mathtex:artifact:derive": "node scripts/derive-mathtex-artifact.mjs",
    "build:canvas:wasm": "node scripts/build-engine-wasm.mjs canvas",
    "build:engine:wasm": "node scripts/build-engine-wasm.mjs",
    "build:mathtex:wasm": "node scripts/build-engine-wasm.mjs mathtex",
    "build:web": "pnpm test:third-party-notices && tsc --noEmit && vite build && node scripts/smoke-third-party-notices.mjs --web",
    "build:electron:main": "vite build --config vite.electron.config.ts",
    "build:electron": "pnpm build:web && pnpm build:electron:main",
    "build:server": "pnpm test:third-party-notices && vite build --config vite.server.config.ts && node scripts/smoke-third-party-notices.mjs --server",
    "build:account-worker": "wrangler deploy --dry-run --config wrangler.account-control-plane.example.jsonc --outdir dist-account-worker",
    "deploy:account-worker": "wrangler deploy --config wrangler.account-control-plane.jsonc",
    "build:billing-worker": "wrangler deploy --dry-run --config wrangler.billing-control-plane.example.jsonc --outdir dist-billing-worker",
    "deploy:billing-worker": "wrangler deploy --config wrangler.billing-control-plane.jsonc",
    "build:collaboration-worker": "wrangler deploy --dry-run --config wrangler.editor-collaboration.example.jsonc --outdir dist-collaboration-worker",
    "deploy:collaboration-worker": "wrangler deploy --config wrangler.editor-collaboration.jsonc",
    "build:sandbox-broker": "vite build --config vite.sandbox-broker.config.ts",
    "build:render-sandbox-broker": "vite build --config vite.render-sandbox-broker.config.ts",
    "start:sandbox-broker": "node dist-sandbox-broker/fast-manim-sandbox-broker.mjs",
    "start:render-sandbox-broker": "node dist-render-sandbox-broker/manim-render-sandbox-broker.mjs",
    "package:electron": "pnpm electron:install && pnpm build:electron && node scripts/package-electron.mjs && node scripts/smoke-third-party-notices.mjs --electron",
    "check:web": "pnpm build:web",
    "tauri": "tauri"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1095.0",
    "@lezer/python": "1.1.19",
    "@tauri-apps/api": "2.11.1",
    "clsx": "2.1.1",
    "katex": "0.18.1",
    "motion": "^12.42.2",
    "openai": "^6.48.0",
    "openid-client": "6.8.4",
    "pg": "8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^26.1.1",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "concurrently": "10.0.3",
    "electron": "43.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "^4.1.10",
    "wait-on": "9.0.10",
    "wrangler": "4.118.0"
  }
}
