{
  "name": "@poietra/studio-lab",
  "version": "0.0.0",
  "private": true,
  "main": "dist-electron/app-main.mjs",
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run src/ai src/engine src/studio --exclude src/studio/workspace-projection.test.ts",
    "test:integration": "vitest run server src/render-pipeline src/studio/workspace-projection.test.ts",
    "test:storage:e2e": "node scripts/run-workspace-source-storage-e2e.mjs",
    "test:engine:wasm-smoke": "node scripts/smoke-engine-wasm.mjs",
    "test:manim-smoke": "node scripts/run-manim-smoke.mjs",
    "test:render-sandbox:oci:required": "POIETRA_MANIM_RENDER_GATED_OCI_REQUIRED=1 vitest run server/manim-render-gated-oci.real.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:preview": "pnpm test:e2e:preview:chromium && pnpm test:e2e:preview:webgpu",
    "test:e2e:preview:chromium": "playwright test --config playwright.preview.config.ts --project preview-chromium --fully-parallel --workers 4",
    "test:e2e:preview:webgpu": "playwright test --config playwright.preview.config.ts --project preview-webgpu --workers 1",
    "test:e2e:preview:real": "playwright test --config playwright.real-preview.config.ts",
    "test:electron-packaged": "pnpm package:electron && node scripts/electron-packaged-smoke.mjs",
    "test:e2e:webkit-smoke": "playwright test --project=webkit-minimum",
    "lint": "biome lint --error-on-warnings .",
    "lint:fix": "biome lint --write .",
    "format": "node scripts/biome-changed.mjs --write",
    "format:check": "node scripts/biome-changed.mjs",
    "check:style": "pnpm lint && pnpm format:check",
    "dev:web": "vite --host 127.0.0.1",
    "electron:install": "install-electron",
    "dev:electron": "pnpm electron:install && pnpm build:electron:main && concurrently --kill-others --success first \"pnpm dev:web\" \"wait-on tcp:127.0.0.1:5173 && electron dist-electron/app-main.mjs\"",
    "dev:tauri": "tauri dev",
    "evaluate:shell:native": "node scripts/shell-evaluation.mjs native",
    "evaluate:shell:serve": "node scripts/shell-evaluation.mjs prepare && vite --host 127.0.0.1 --port 4174 --strictPort",
    "benchmark:engine:webgpu": "node scripts/run-engine-webgpu-benchmark.mjs",
    "sandbox:oci:gated:build": "node scripts/build-fast-manim-gated-oci.mjs",
    "sandbox:oci:render:build": "node scripts/build-fast-manim-gated-oci.mjs render",
    "build:engine:wasm": "node scripts/build-engine-wasm.mjs",
    "build:web": "tsc --noEmit && vite build",
    "build:electron:main": "vite build --config vite.electron.config.ts",
    "build:electron": "pnpm build:web && pnpm build:electron:main",
    "build:server": "vite build --config vite.server.config.ts",
    "build:sandbox-broker": "vite build --config vite.sandbox-broker.config.ts",
    "build:render-sandbox-broker": "vite build --config vite.render-sandbox-broker.config.ts",
    "start:sandbox-broker": "node dist-sandbox-broker/fast-manim-sandbox-broker.mjs",
    "start:render-sandbox-broker": "node dist-render-sandbox-broker/manim-render-sandbox-broker.mjs",
    "package:electron": "pnpm electron:install && pnpm build:electron && node scripts/package-electron.mjs",
    "check:web": "pnpm build:web",
    "tauri": "tauri"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1095.0",
    "@tauri-apps/api": "2.11.1",
    "clsx": "2.1.1",
    "katex": "0.18.1",
    "motion": "^12.42.2",
    "openai": "^6.48.0",
    "pg": "8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^26.1.1",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "concurrently": "10.0.3",
    "electron": "43.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "^4.1.10",
    "wait-on": "9.0.10"
  }
}
