{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "poietra-account-control-plane",
  "main": "server/cloudflare-account-control-plane-worker.ts",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat", "disallow_importable_env"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "https://studio.example.com/auth/oidc/*",
      "zone_name": "example.com"
    },
    {
      "pattern": "https://studio.example.com/api/account/session",
      "zone_name": "example.com"
    },
    {
      "pattern": "https://studio.example.com/api/account/logout",
      "zone_name": "example.com"
    },
    {
      "pattern": "https://studio.example.com/api/account/invitations",
      "zone_name": "example.com"
    },
    {
      "pattern": "https://studio.example.com/api/account/invitations/*",
      "zone_name": "example.com"
    },
    {
      "pattern": "https://studio.example.com/api/account/organizations",
      "zone_name": "example.com"
    }
  ],
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "vars": {
    "POIETRA_PUBLIC_ORIGIN": "https://studio.example.com",
    "POIETRA_OIDC_ISSUER": "https://identity.example.com",
    "POIETRA_OIDC_CLIENT_ID": "replace-with-production-client-id",
    "POIETRA_OIDC_CLIENT_AUTHENTICATION": "client_secret_post"
  },
  "secrets": {
    "required": ["POIETRA_OIDC_CLIENT_SECRET"]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000"
    }
  ],
  "ratelimits": [
    {
      "name": "INVITATION_MUTATION_RATE_LIMITER",
      "namespace_id": "31203",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "ORGANIZATION_MUTATION_RATE_LIMITER",
      "namespace_id": "31204",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "OIDC_START_RATE_LIMITER",
      "namespace_id": "31201",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "OIDC_CALLBACK_RATE_LIMITER",
      "namespace_id": "31202",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
