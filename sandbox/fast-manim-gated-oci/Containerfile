FROM manimcommunity/manim@sha256:f18f53f2e4eaf2ea41713437d34363fb3f5cc6008b03fd798676ac0359396c3b

ARG FAST_MANIM_ARCHIVE_SHA256
ARG FAST_MANIM_COMMIT
ARG FAST_MANIM_TREE

USER root
COPY fast-manim.tar.gz /opt/poietra-build/fast-manim.tar.gz
COPY gated-entrypoint.py /opt/poietra/gated-entrypoint.py

RUN test "$FAST_MANIM_ARCHIVE_SHA256" = "00413ce7ae00d4affa318a701831db369c70ba02f20a6babc44e7d7db8702694" \
    && test "$FAST_MANIM_COMMIT" = "7d20dc2d6dce4e84d4c24bc9509aff4094279ee7" \
    && test "$FAST_MANIM_TREE" = "f80a55d0764259df9f80b89dd47a18d51e0623db" \
    && printf '%s  %s\n' "$FAST_MANIM_ARCHIVE_SHA256" /opt/poietra-build/fast-manim.tar.gz \
      | sha256sum --check --strict - \
    && mkdir --parents /opt/fast-manim /run/poietra \
    && tar --extract --gzip --file=/opt/poietra-build/fast-manim.tar.gz \
      --directory=/opt/fast-manim --strip-components=1 --no-same-owner \
    && test "$(sha256sum /opt/fast-manim/pyproject.toml | cut -d ' ' -f 1)" \
      = "f791e3ab6ef3e12457e3f36f5d7d7d4c249ae97678d23607781556556a5d6012" \
    && test "$(sha256sum /opt/fast-manim/uv.lock | cut -d ' ' -f 1)" \
      = "3244a21383800a8a1049438f24c54121c483b1a4ab24ae8523d8c852b7431753" \
    && rm --force /opt/poietra-build/fast-manim.tar.gz \
    && chmod 0555 /opt/poietra /opt/poietra/gated-entrypoint.py /run/poietra \
    && chmod --recursive go-w /opt/fast-manim \
    && PYTHONHASHSEED=0 PYTHONPATH=/opt/fast-manim \
      /opt/venv/bin/python -c 'from manim.renderer.source_runtime_identity import export_source_runtime_identity; assert callable(export_source_runtime_identity)'

LABEL io.poietra.fast-manim.commit="7d20dc2d6dce4e84d4c24bc9509aff4094279ee7" \
      io.poietra.fast-manim.tree="f80a55d0764259df9f80b89dd47a18d51e0623db" \
      io.poietra.fast-manim.archive-sha256="00413ce7ae00d4affa318a701831db369c70ba02f20a6babc44e7d7db8702694" \
      io.poietra.sandbox-slice="gated-oci-v1"

ENV HOME=/run/poietra/home \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PATH=/opt/venv/bin:/usr/local/bin:/usr/bin:/bin \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONHASHSEED=0 \
    PYTHONNOUSERSITE=1 \
    PYTHONPATH=/opt/fast-manim \
    TMPDIR=/run/poietra/tmp \
    TZ=UTC \
    XDG_CACHE_HOME=/run/poietra/cache \
    XDG_CONFIG_HOME=/run/poietra/config \
    XDG_DATA_HOME=/run/poietra/data

USER 65532:65532
WORKDIR /run/poietra
ENTRYPOINT ["/opt/venv/bin/python", "/opt/poietra/gated-entrypoint.py"]
CMD ["/opt/venv/bin/python", "-m", "manim.renderer.source_runtime_identity"]
