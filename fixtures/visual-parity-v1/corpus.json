        "heightPx": 8,
        "kind": "uniform",
        "stridePx": 8,
        "widthPx": 8
      }
    },
    "pixelDifference": {
      "classification": "any-rgba-channel-strictly-greater",
      "thresholdU8": 8
    },
    "diffImage": "max-absolute-rgba-grayscale-opaque"
  },
  "defaultThresholds": {
    "maximumPixelFractionAboveThreshold": 0.005,
    "minimumSsim": 0.995
  },
