    "colorDomain": "srgb-u8",
    "alpha": "stored-premultiplied-rgba-four-channels-equal-weight",
    "ssim": {
      "aggregation": "unweighted-arithmetic-mean-of-window-channel-scores",
      "channels": ["red", "green", "blue", "alpha"],
      "constants": { "dynamicRange": 255, "k1": 0.01, "k2": 0.03 },
      "variance": "population",
      "window": {
        "edge": "clip",
        "edgeWindowWeight": "equal",
        "heightPx": 8,
        "kind": "uniform",
        "stridePx": 8,
        "widthPx": 8
      }
    },
    "pixelDifference": {
      "classification": "any-rgba-channel-strictly-greater",
      "thresholdU8": 8
    },
    "diffImage": "max-absolute-rgba-grayscale-opaque"
  },
  "defaultThresholds": {
    "maximumPixelFractionAboveThreshold": 0.005,
    "minimumSsim": 0.995
  },
