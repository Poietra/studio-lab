{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "includes": [
      "**",
      "!!src-tauri/icons",
      "!!fixtures/mathtex-manim-parity-v1",
      // Exact dvisvgm cache inputs are hash-pinned evidence, not authored UI SVGs.
      "!!fixtures/write-stuff-tex-cache-v1",
      // Sealed producer output stays canonical/minified; formatting it would add thousands of generated lines.
      "!!server/test-fixtures/fast-manim-*-combined.json",
      "!!fixtures/manim-tex-natural-metrics-v1/reference.json",
      "!!fixtures/engine-v1/real-mathtex-morph-v5.json",
      "!!fixtures/engine-v1/real-generic-vmobject-v6.json",
      "!!fixtures/engine-v1/real-line-joints-v10.json",
      "!!fixtures/engine-v1/real-line-joints-v10-edited.json",
      "!!fixtures/engine-v1/real-square-to-circle-v8.json",
      "!!fixtures/engine-v1/real-spiral-in-v11.json",
      "!!fixtures/engine-v1/real-warp-square-v9.json",
      "!!fixtures/engine-v1/real-write-stuff-v12.json",
      "!!fixtures/engine-v1/real-write-stuff-v12-edited.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      // These rules conflict with established patterns in the current baseline.
      // Keeping the exceptions explicit lets new recommended rules remain enabled.
      "a11y": {
        "useAriaPropsSupportedByRole": "off",
        "useButtonType": "off",
        "useMediaCaption": "off",
        "useSemanticElements": "off"
      },
      "complexity": {
        "noImportantStyles": "off",
        "noUselessStringRaw": "off",
        "useOptionalChain": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      },
      "style": {
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noControlCharactersInRegex": "off",
        "noImplicitAnyLet": "off",
        "noShadowRestrictedNames": "off",
        "useIterableCallbackReturn": "off"
      }
    }
  }
}
